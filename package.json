{
  "name": "minecraftle",
  "version": "0.0.0",
  "description": "A daily puzzle game fusing Wordle and Minecraft crafting recipes",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "gen-data": "node scripts/gen-data.ts",
    "lint": "eslint .",
    "lint-fix": "eslint --fix .",
    "type-check": "vue-tsc --noEmit",
    "prepare": "husky || true",
    "test": "playwright test --max-failures=1",
    "test-unit": "playwright test --project unit --max-failures=1",
    "test-e2e": "playwright test --project e2e --max-failures=1",
    "quality": "npm run lint && npm run type-check && npm run build && npm test"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10",
    "vuetify": "^4.1.12"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-vuetify": "^2.7.2",
    "husky": "^9.1.7",
    "neostandard": "^0.13.0",
    "sass-embedded": "^1.103.1",
    "sharp": "^0.34.4",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  }
}
